Algoritmo P1A10_06_CostaRivasPedro
	Definir total, num Como Entero
	Definir mas Como Lógico
	total <- 0
	Mientras mas Hacer
		Escribir 'Ingrese número: '
		Leer num
		Si num=0 Entonces
			total <- total+1
		FinSi
		Escribir '¿Más números?'
		Leer mas
	FinMientras
	Escribir total
FinAlgoritmo
